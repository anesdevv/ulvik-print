# --- FRONTEND ENVIRONMENT VARIABLES ---
# The URL of your Supabase project (used by Auth on the client side)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
# The anonymous API key of your Supabase project (public client operations)
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# Base API url. Keep empty or set to /api in production on Vercel
VITE_API_URL=/api

# --- BACKEND ENVIRONMENT VARIABLES ---
# The URL of your Supabase project (re-defined for the server runtime)
SUPABASE_URL=https://your-project-id.supabase.co
# The Service Role Key. Crucial: Keep private. Enables RLS bypass.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# Node environment (development / production)
NODE_ENV=development
# Port used for local backend server debugging
PORT=5000
